{
  "name": "playwright-tia",
  "version": "1.1.1",
  "description": "Test Impact Analysis for Playwright: run only the specs affected by changes in your app's source code, using real per-spec V8 coverage.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pw-tia": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Mathias Paulenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MathiasPaulenko/playwright-tia.git"
  },
  "keywords": [
    "playwright",
    "testing",
    "test-impact-analysis",
    "e2e",
    "ci",
    "coverage"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "tsup": "^8.5.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "~8.70.1",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "picomatch": "^4.0.7"
  }
}
